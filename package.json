{
  "name": "terms-apply",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e/public.spec.ts",
    "test:services": "node scripts/test-services.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src netlify tests scripts docs *.ts *.json README.md AGENTS.md .github"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.4.1",
    "@netlify/functions": "^5.1.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  }
}
